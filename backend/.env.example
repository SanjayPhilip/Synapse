# ------------------------------------------------------------------
# Backend environment — copy to backend/.env and fill in your keys:
#   cp backend/.env.example backend/.env
# ------------------------------------------------------------------

# --- Database ---
# SQLite is the zero-config default for local development.
DATABASE_URL=sqlite+aiosqlite:///./synapse.db
DATABASE_URL_SYNC=sqlite:///./synapse.db
# For PostgreSQL (production), use instead:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/synapse
# DATABASE_URL_SYNC=postgresql+psycopg2://user:pass@host:5432/synapse

# --- Auth (JWT) ---
# CHANGE THIS in any real deployment. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI ---
# Required for resume parsing enhancement, rewrites, and the chat assistant.
GEMINI_API_KEY=

# --- External job search (optional) ---
# The external feed is disabled until these are set.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JSEARCH_API_KEY=

# --- Cache (reserved) ---
REDIS_URL=redis://localhost:6379/0

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000"]
