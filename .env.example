# ------------------------------------------------------------------
# Frontend environment — copy to .env in the project root and adjust:
#   cp .env.example .env
# ------------------------------------------------------------------

# Base URL of the FastAPI backend.
VITE_API_URL=http://localhost:8000

# Supabase (needed for external job search edge function + optional auth)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# OAuth Client IDs (Optional: enables native OAuth provider authentication)
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
